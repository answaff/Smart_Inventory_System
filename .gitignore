$ignoreRules = @'
# Python and Django
**/venv/
**/.venv/
**/__pycache__/
*.py[cod]
*.sqlite3
*.log

# Environment variables and secrets
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
*.pem
*.key

# React and React Native
**/node_modules/
**/.expo/
**/dist/
**/build/
**/.next/

# Database backups and archives
*.sql
*.sql.gz
*.bak
*.zip

# Local editor files
.vscode/
.idea/
.DS_Store
'@

if (Test-Path ".gitignore") {
    Add-Content -Path ".gitignore" -Value $ignoreRules
} else {
    Set-Content -Path ".gitignore" -Value $ignoreRules
}

Write-Host "SUCCESS: Git ignore rules configured." -ForegroundColor Green
# Django deployment files
backend/staticfiles/
backend/config/settings*.bak
backend/config/settings.backup.py
backend/.env*
**/settings.backup.py
**/settings*.bak
